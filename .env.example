# ---------- Supabase (Dashboard -> Connect / Project Settings -> API Keys) ----------
# The PUBLISHABLE key is safe in the browser: access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# (Older projects: the "anon" key works too — use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.)

# Public site URL, used for QR codes, links in texts and metadata (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- SERVER-ONLY secrets (never prefix these with NEXT_PUBLIC_) ----------
# Needed to create member/staff logins, reset passwords and store member photos.
# Supabase -> Project Settings -> API Keys -> "Secret key". Set it on your host as a
# server environment variable too. Never commit it or paste it into chat.
SUPABASE_SECRET_KEY=

# Only for `npm run db:migrate` (applies the SQL migrations). Supabase -> Connect ->
# "Session pooler" connection string, with your database password filled in.
SUPABASE_DB_URL=

# ---------- Text messages for password resets (optional) ----------
# Leave SMS_PROVIDER empty and coaches get the message to send from their own phone.
# SMS_PROVIDER=semaphore
# SEMAPHORE_API_KEY=
# SEMAPHORE_SENDER_NAME=
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1...
# Country code for numbers typed without one (63 = Philippines)
# SMS_DEFAULT_COUNTRY_CODE=63

# ---------- Limits ----------
# The app refuses new photo uploads once database + files reach this many GB.
# DATA_BUDGET_GB=5
